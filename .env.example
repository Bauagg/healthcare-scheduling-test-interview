# Copy to .env and adjust. Never commit the real .env file.

# --- Auth Service ---
AUTH_PORT=3001
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=change-me
AUTH_DB_NAME=auth_db
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10

# --- Schedule Service ---
SCHEDULE_PORT=3002
SCHEDULE_DB_USER=postgres
SCHEDULE_DB_PASSWORD=change-me
SCHEDULE_DB_NAME=schedule_db
