            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query($doctorId: ID, $from: DateTime, $to: DateTime) {\n  schedules(page: 1, limit: 10, doctorId: $doctorId, from: $from, to: $to) {\n    total totalPages\n    items { id objective scheduledAt customer { name } doctor { name } }\n  }\n}",
                "variables": "{\n  \"doctorId\": \"{{doctor_id}}\",\n  \"from\": \"2026-12-01T00:00:00Z\",\n  \"to\": \"2026-12-31T23:59:59Z\"\n}"
              }
            },
            "url": "{{schedule_url}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
