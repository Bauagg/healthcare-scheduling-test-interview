    {
      "name": "Schedules",
      "item": [
        {
          "name": "createSchedule",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation($input: CreateScheduleInput!) {\n  createSchedule(input: $input) {\n    id objective scheduledAt\n    customer { id name }\n    doctor { id name }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"objective\": \"Medical check-up\",\n    \"customerId\": \"{{customer_id}}\",\n    \"doctorId\": \"{{doctor_id}}\",\n    \"scheduledAt\": \"2026-12-01T09:00:00Z\"\n  }\n}"
              }
            },
            "url": "{{schedule_url}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data; if (d) pm.collectionVariables.set('schedule_id', d.createSchedule.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "createSchedule (same doctor + time -> Conflict)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation($input: CreateScheduleInput!) {\n  createSchedule(input: $input) { id }\n}",
                "variables": "{\n  \"input\": {\n    \"objective\": \"Should fail\",\n    \"customerId\": \"{{customer_id}}\",\n    \"doctorId\": \"{{doctor_id}}\",\n    \"scheduledAt\": \"2026-12-01T09:00:00Z\"\n  }\n}"
              }
            },
            "url": "{{schedule_url}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "schedules (filtered)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
