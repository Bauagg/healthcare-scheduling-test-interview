{
  "info": {
    "name": "Healthcare Scheduling System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "auth_url",
      "value": "http://localhost:3001/graphql"
    },
    {
      "key": "schedule_url",
      "value": "http://localhost:3002/graphql"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "customer_id",
      "value": ""
    },
    {
      "key": "doctor_id",
      "value": ""
    },
    {
      "key": "schedule_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth Service",
      "item": [
        {
          "name": "register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Register($input: RegisterInput!) {\n  register(input: $input) { id email createdAt }\n}",
                "variables": "{\n  \"input\": {\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\"\n  }\n}"
              }
            },
            "url": "{{auth_url}}"
          }
        },
        {
          "name": "login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Login($input: LoginInput!) {\n  login(input: $input) { accessToken user { id email } }\n}",
                "variables": "{\n  \"input\": {\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\"\n  }\n}"
              }
            },
            "url": "{{auth_url}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data; if (d) pm.collectionVariables.set('token', d.login.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "validateToken",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Validate($token: String!) {\n  validateToken(token: $token) { id email }\n}",
                "variables": "{\n  \"token\": \"{{token}}\"\n}"
              }
            },
            "url": "{{auth_url}}"
          }
        }
      ]
    },
